# Copiar como .env en la carpeta backend-infra-ti; .env no se versiona.
DB_URL=jdbc:postgresql://127.0.0.1:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=tu_clave_local
ETL_BASE_URL=http://127.0.0.1:8001
ETL_API_KEY=clave_compartida_con_el_etl
# Misma llave externa que utiliza Python; no generar otra si la BD ya está cifrada.
SNMP_CREDENTIAL_KEY_FILE=/ruta/privada/snmp_credentials.key
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# JSON opcional: destino|usuario -> clave de privacidad SNMPv3.
SNMP_PRIVACY_KEYS_JSON={}
